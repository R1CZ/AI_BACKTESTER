# MT5 Worker Configuration
# Copy this file to .env and fill in your values

# API Security
# Generate a secure token: python -c "import secrets; print(secrets.token_urlsafe(32))"
MT5_API_TOKEN=your-secure-token-here

# Server Configuration
MT5_HOST=0.0.0.0
MT5_PORT=8765

# MT5 Connection (optional - will use existing terminal session if not provided)
# MT5_LOGIN=12345678
# MT5_PASSWORD=your-password
# MT5_SERVER=YourBroker-Demo
